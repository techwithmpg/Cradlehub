<?xml version="1.0" encoding="utf-8"?>
<!-- Single source of trip controls: the focused Staff Driver PWA route.
     Native navigation is opened after the authorized Start Trip action.
     Do not overlay a second, competing navigation button over the WebView. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <WebView android:id="@+id/driverWeb"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
</FrameLayout>
