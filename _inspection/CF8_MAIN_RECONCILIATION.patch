+  const res = runPsql(sql, ['-t', '-A', '-q']);
+  if (!res.ok) return res;
+  const lines = res.output
+    .split('\n')
+    .map((l) => l.trim())
+    .filter((l) => l && l !== 'SET' && l !== 'BEGIN' && l !== 'COMMIT');
+  return { ok: true, output: lines.join('\n') };
+}
