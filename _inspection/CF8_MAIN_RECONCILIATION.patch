+    } catch {}
+
+    execSync(
+      `docker run -d --name ${containerName} -e POSTGRES_PASSWORD=postgres public.ecr.aws/supabase/postgres:17.6.1.167`,
+      { stdio: 'inherit' }
+    );
+    spawnedContainer = true;
+
+    let consecutiveSuccesses = 0;
+    for (let i = 0; i < 40; i++) {
