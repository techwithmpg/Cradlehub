+    DECLARE
+      v_branch_id UUID;
+    BEGIN
+      SELECT s.branch_id INTO v_branch_id
+      FROM public.staff s
+      WHERE s.auth_user_id = auth.uid()
+        AND s.is_active = true
+      LIMIT 1;
+      RETURN v_branch_id;
+    END;
+    $$;
