+      USING ERRCODE = '55000';
+  END IF;
+
+  IF to_regprocedure(
+    'public.post_transfer_atomic(uuid,uuid,uuid,numeric,date,text,text)'
+  ) IS NULL THEN
+    RAISE EXCEPTION
