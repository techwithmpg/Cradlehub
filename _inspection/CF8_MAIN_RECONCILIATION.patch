+      ${date ? `'${date}'::date` : 'NULL'},
+      ${notes ? `'${notes.replace(/'/g, "''")}'` : 'NULL'},
+      ${receiptPath ? `'${receiptPath.replace(/'/g, "''")}'` : 'NULL'}
